{
  "name": "capibara-aeronautics-launcher",
  "version": "1.0.21",
  "description": "Launcher para Capibara Aeronautics SMP",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "discord-rpc": "^4.0.1",
    "minecraft-launcher-core": "^3.17.3",
    "node-stream-zip": "^1.15.0",
    "ping-minecraft-server": "^1.0.1"
  },
  "devDependencies": {
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.capibaraaeronatics.launcher",
    "productName": "Capibara Aeronautics Launcher",
    "directories": {
      "output": "dist"
    },
    "compression": "store",
    "electronLanguages": [
      "es",
      "en-US"
    ],
    "files": [
      "src/**/*",
      "resources/logo.png",
      "resources/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "CapibaraAeronauticsLauncher.exe",
      "unpackDirName": "CapibaraAeronauticsLauncher"
    }
  }
}
