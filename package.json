{
  "name": "capibara-aeronautics-launcher",
  "version": "1.1.1",
  "description": "Launcher para Capibara Aeronautics SMP",
  "main": "src/main.js",
  "scripts": {
    "vite:dev": "vite",
    "vite:build": "vite build",
    "start": "electron .",
    "dev": "concurrently -k -n vite,electron -c blue,yellow \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build && electron-builder --win",
    "build:dir": "vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "discord-rpc": "^4.0.1",
    "minecraft-launcher-core": "^3.17.3",
    "node-stream-zip": "^1.15.0",
    "ping-minecraft-server": "^1.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.capibaraaeronatics.launcher",
    "productName": "Capibara Aeronautics Launcher",
    "directories": {
      "output": "dist"
    },
    "compression": "store",
    "electronLanguages": [
      "es",
      "en-US"
    ],
    "files": [
      "src/main.js",
      "src/preload.js",
      "src/launcher/**/*",
      "src/renderer-dist/**/*",
      "resources/logo.png",
      "resources/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "CapibaraAeronauticsLauncher.exe",
      "unpackDirName": "CapibaraAeronauticsLauncher"
    }
  }
}
